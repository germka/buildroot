+/* The values are boolean, zero for low, nonzero for high.
+ https://www.kernel.org/doc/Documentation/gpio/gpio-legacy.txt
+*/
+enum pps_gen_gpio_level {
+	PPS_GPIO_LOW = 0,
+	PPS_GPIO_HIGH = 1
+};
