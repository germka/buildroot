+/**
+ * Get distance seconds tick
+ *
+ * Отставание/опережение относительно близжайшего секундного тика
+ *
+ * return long , ns - фактический перелет/недолет;  -500ms <= d <= 500ms;
+ *  d < 0 - запаздывание вызова пульса от тика системной секунды;
+ *  d > 0 - вызов пульса раньше времени; cекундный тик еще не произошел
+ */
+static long get_sectick_distance(struct timespec64 *ts)
+{
+	long d1;
+
+	d1 = ts->tv_nsec - NSEC_PER_SEC/2;
+	if (d1 > 0) d1 = NSEC_PER_SEC/2 - d1;
+	if (d1 < 0) d1 = -NSEC_PER_SEC/2 - d1;
+	return d1;
+}
+
+/**
+ * DRIVER API SECTION
+ */
+
+/**
+ * The compatible property here defined is searched for in the DT
+ */
+static const struct of_device_id pps_gen_gpio_dt_ids[] = {
+        { .compatible = "pps-gen-gpio", },
+        { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, pps_gen_gpio_dt_ids);
+
+/**
+ * Device sysfs attributes
+ */
+static ssize_t pps_gen_gpio_count_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    struct pps_gen_gpio_devdata *devdata = dev_get_drvdata(dev);
+    int len;
+
+    len = sprintf(buf, "%lu\n", devdata->count);
+    if (len <= 0)
+        dev_err(dev, "mydrv: Invalid sprintf len: %d\n", len);
+    return len;
+}
+static DEVICE_ATTR(pps_count, S_IRUGO, pps_gen_gpio_count_show, NULL);
+
+static ssize_t pps_gen_gpio_restart_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct pps_gen_gpio_devdata *devdata = dev_get_drvdata(dev);
+	int len;
+
+	len = sprintf(buf, "%lu\n", devdata->restart);
+	if (len <= 0)
+		dev_err(dev, "mydrv: Invalid sprintf len: %d\n", len);
+	return len;
+}
+static DEVICE_ATTR(restart, S_IRUGO, pps_gen_gpio_restart_show, NULL);
+
+
+static struct attribute *pps_gen_gpio_attrs[] = {
+    &dev_attr_pps_count.attr,
+    &dev_attr_restart.attr,
+    NULL
+};
+ATTRIBUTE_GROUPS(pps_gen_gpio);
+
+
+
+static int pps_gen_gpio_probe(struct platform_device *pdev)
+{
+    int ret;
+    struct device *dev = &pdev->dev;
+    struct pps_gen_gpio_devdata *devdata;
+    pr_info(DRV_LOG_PREFIX "probe\n");
+
+    /* Allocate space for device info. */
+    devdata = devm_kzalloc(dev, sizeof(struct pps_gen_gpio_devdata), GFP_KERNEL);
+    if (!devdata) {
+        dev_err(dev, "Can't allocate memory space\n");
+            ret = -ENOMEM;
+            goto err_alloc;
+    }
+
+    /* There should be a single PPS generator GPIO pin defined in DT. */
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+    if (of_gpio_named_count(dev->of_node, "pps-gen-gpio") != 1) {
+#else
+    if (gpiod_count(dev, "pps-gen-gpio") != 1) {
+#endif
+        dev_err(dev, "There should be exactly one pps-gen GPIO defined in DT\n");
+        return -EINVAL;
+    }
+
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+    devdata->pps_gpio = devm_gpiod_get(dev, "pps-gen", GPIOD_OUT_LOW);
+    if (IS_ERR(devdata->pps_gpio)) {
+        ret = PTR_ERR(devdata->pps_gpio);
+        dev_err(dev, "Cannot get PPS GPIO [%d]\n", ret);
+        goto err_gpio_get;
+    }
+#else
+	devdata->pps_gpio = devm_gpiod_get(dev, "pps-gen-gpio", GPIOD_OUT_LOW);
+	if (IS_ERR(devdata->pps_gpio)) {
+	    dev_err(dev, "failed to get pps-gen-gpio: %ld\n", PTR_ERR(devdata->pps_gpio));
+	    return PTR_ERR(devdata->pps_gpio);
+	}
+#endif
+
+#ifdef DEV_ATTR_ENABLED
+    ret = sysfs_create_group(&pdev->dev.kobj, &pps_gen_gpio_group);
+    if (ret) {
+        dev_err(&pdev->dev, "sysfs creation failed\n");
+        return ret;
+    }
+#endif
+
+    {
+        pps_gen_gpio_wq = create_workqueue("pps-gen-gpio-wq");
+        if (!pps_gen_gpio_wq) {
+            printk(KERN_ERR DRV_LOG_PREFIX "No memory for workqueue\n");
+            return 1;
+        }
+        printk(KERN_INFO DRV_LOG_PREFIX "Create Workqueue successful!\n");
+
+        INIT_DELAYED_WORK(&devdata->work, worker_func);
+        queue_delayed_work(pps_gen_gpio_wq, &devdata->work, msecs_to_jiffies(1000));
+    }
+
+    platform_set_drvdata(pdev, devdata);
+    pr_info(DRV_LOG_PREFIX "probe complete\n");
+
+    return 0;
+
+err_gpio_dir:
+    devm_gpiod_put(dev, devdata->pps_gpio);
+err_gpio_get:
+err_dt:
+    devm_kfree(dev, devdata);
+
+err_alloc:
+    return ret;
+}
+
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+static int pps_gen_gpio_remove(struct platform_device *pdev)
+#else
+static void pps_gen_gpio_remove(struct platform_device *pdev)
+#endif
+{
+    struct device *dev = &pdev->dev;
+    struct pps_gen_gpio_devdata *devdata = platform_get_drvdata(pdev);
+
+    devm_gpiod_put(dev, devdata->pps_gpio);
+
+    {
+        cancel_delayed_work(&devdata->work);
+        flush_workqueue(pps_gen_gpio_wq); /* ждать пока отработает таймер */
+        destroy_workqueue(pps_gen_gpio_wq);
+    }
+
+#ifdef DEV_ATTR_ENABLED
+    sysfs_remove_group(&pdev->dev.kobj, &pps_gen_gpio_group);
+#endif
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+    return 0;
+#endif
+}
+
+static struct platform_driver pps_gen_gpio_driver = {
+    .driver = {
+        .name           = "pps_gen_gpio",
+        .owner          = THIS_MODULE,
+        .of_match_table = of_match_ptr(pps_gen_gpio_dt_ids),
+        .dev_groups = pps_gen_gpio_groups,
+    },
+    .probe              = pps_gen_gpio_probe,
+    .remove             = pps_gen_gpio_remove,
+};
+
+
+static int __init pps_gen_gpio_init(void)
+{
+    pr_info(DRVDESC " v%s-build%d\n", PPS_GEN_GPIO_VERSION, PPS_GEN_GPIO_BUILD);
+    pr_info(DRV_LOG_PREFIX "init\n");
+
+    init_hrtimer_nanosleep_ptr();
+
+    platform_driver_register(&pps_gen_gpio_driver);
+    return 0;
+}
+
+static void __exit pps_gen_gpio_exit(void)
+{
+    printk(KERN_INFO DRV_LOG_PREFIX "exit\n");
+
+    platform_driver_unregister(&pps_gen_gpio_driver);
+}
+
+module_init(pps_gen_gpio_init);
+module_exit(pps_gen_gpio_exit);
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Andrei Petrov <av.petrov@taipit.ru>");
+MODULE_VERSION(PPS_GEN_GPIO_VERSION);
