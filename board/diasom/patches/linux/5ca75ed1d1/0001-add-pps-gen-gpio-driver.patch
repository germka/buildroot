+/**
+  * Sleep in usec
+  */
+static void sleep(u64 delay_usec)
+{
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+    struct timespec64 ts = {
+        .tv_nsec = delay_usec * NSEC_PER_USEC,
+    };
+#if 0
+    hrtimer_nanosleep(&ts, HRTIMER_MODE_REL, CLOCK_MONOTONIC);
+    //ERROR: "hrtimer_nanosleep" [.../0.1-r0/pps_gen_gpio.ko] undefined!
+    //функция в ядре неэкспортируемая
+#else
+    (* hrtimer_nanosleep_p)(&ts, HRTIMER_MODE_REL, CLOCK_MONOTONIC);
+#endif
+
+#else
+    ktime_t rqtp = ns_to_ktime(delay_usec);
+    hrtimer_nanosleep_p(rqtp, HRTIMER_MODE_REL, CLOCK_MONOTONIC);
+#endif
+}
