+#define DRVDESC				"GPIO PPS signal generator"
+#define DRV_LOG_PREFIX			"pps_gen_gpio: "
+#define PPS_GEN_GPIO_VERSION		"2.4.0"
+#define PPS_GEN_GPIO_BUILD		50
+#define HRTIMER_NANOSLEEP_ADDR		0x80178ef4
+//#define	DEV_ATTR_ENABLED
+#define AUX_TIMEOUT			1*HZ		/* base PPS frequency */
+#define NSEC_PER_JIFFIE			10000000	/* nanosec in one jiffie (= jiffies_to_nsecs(1)) - в различных системах отлична, поэтому стоит проверка на соответствие при старте */
+#define USEC_PER_JIFFIE			10000
+#define PPS_GEN_ADJ_MAX_US		20000		/* максимально возможная поправка за одну итерацию */
+
+
+static struct workqueue_struct *pps_gen_gpio_wq;	// queue
+//static struct delayed_work pps_gen_gpio_dwq;		// task
+
+/**
+ * support none-exported kernel function hrtimer_nanosleep()
+ */
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+typedef long (*hrtimer_nanosleep_pointer_t)(const struct timespec64 *rqtp, const enum hrtimer_mode mode, const clockid_t clockid);
+static hrtimer_nanosleep_pointer_t hrtimer_nanosleep_p = HRTIMER_NANOSLEEP_ADDR;		// see /proc/kallsyms
+#else
+typedef long (*hrtimer_nanosleep_t)(ktime_t rqtp, const enum hrtimer_mode mode, const clockid_t clockid);
+static hrtimer_nanosleep_t hrtimer_nanosleep_p;
+#endif
