+/**
+ * IMPLEMENTATION SECTION
+ */
+
+/**
+ * Основная рабочая функция
+ */
+void worker_func(struct work_struct *work)
+{
+    struct timespec64 ts_0, ts_1;
+    unsigned long specified_adj_us, resulting_adj_us, dt_add_us;
+    long error0_us;
+
+    struct pps_gen_gpio_devdata *devdata = container_of(to_delayed_work(work), struct pps_gen_gpio_devdata, work);
+
+
+    /* сбор первичных данных о совершенном "прыжке" */
+    {
+        ktime_get_real_ts64(&ts_0);
+        specified_adj_us = 1000000 + devdata->cadj + devdata->adj;	// заданная величина прыжка
+        resulting_adj_us = 0;		// длина реально совершенного прыжка
+        if (devdata->measurement_started)
+        {
+            struct timespec64 dts = timespec64_sub(ts_0, devdata->ts_at_pps_front);
+            resulting_adj_us = dts.tv_sec * 1000000 + dts.tv_nsec /1000;
+        }
+
+        dt_add_us = 0;			// длительность докрутки
+        if (specified_adj_us > resulting_adj_us)
+        dt_add_us = specified_adj_us - resulting_adj_us;
+    }
+
+    /*
+     * Additional precesion sleep
+     *
+     * докрутка до целевого значения "прыжка"
+     *
+     */
+#if 0
+    {
+        s64 tadd0_us = ktime_to_us(ktime_get_real());
+        while(true
+            && ktime_to_us(ktime_get_real()) - tadd0_us < dt_add_us
+        ){
+            sleep(100);
+        }
+    }
+#else
+    sleep(dt_add_us);
+#endif
+
+    /**
+     * прыжок совершен в полном объеме
+     */
+    ktime_get_real_ts64(&ts_1);
+    //--------------------------------------------------------------------------------
+
+    /* сбор итоговых данных о совершенном "прыжке" */
+    {
+        struct timespec64 dts = timespec64_sub(ts_1, devdata->ts_at_pps_front);
+        resulting_adj_us = dts.tv_sec * 1000000 + dts.tv_nsec /1000;
+        devdata->accuracy_us = specified_adj_us - resulting_adj_us;		// точность (смещение результата относительно заданного значения)
+    }
+
+    if (!devdata->measurement_started)
+    {
+        /* перезапуск measurement */
+        struct timespec64 ts;
+        ktime_get_real_ts64(&ts);
+        pps_gen_start_measurement(devdata, &ts);
+    }
+
+    /**
+     * make impulse
+     */
+    {
+        pps_gen_make_impulse(devdata);
+    }
+    /**
+     * отрисовка фронта закончена
+     * критическая секция закончилась
+     */
+    //--------------------------------------------------------------------------------
+
+    /* ошибка pulse относительно системного tick'а */
+    {
+        error0_us = devdata->error_us;
+        devdata->error_us = 0;
+        if (devdata->measurement_started)
+        {
+            devdata->error_us = get_sectick_error(&ts_1, devdata) /1000;
+        }
+    }
+
+#ifndef NO_AUTO_COMPENSATION
+    /**
+     * Компенсация ошибки
+     *
+     * Осуществляется в пределах [-adj_max .. +adj_max], us
+     *
+     */
+    if (devdata->error_us != 0)
+    {
+        /* компенсируем ошибку */
+        const long adj_max = PPS_GEN_ADJ_MAX_US;
+
+        devdata->adj = devdata->error_us;
+        if (devdata->adj > adj_max) devdata->adj = adj_max;
+        if (devdata->adj < -adj_max) devdata->adj = -adj_max;
+        // итоговая поправка cadj+adj
+    }
+#else 
+    devdata->adj = 0;	//TODO: FIXED_ADJ
+#endif
+
+    /**
+     * Планирование следующего вызова рабочей функции
+     */
+    signed long total_adj_j = pps_gen_split_adj(devdata);
+    queue_delayed_work(pps_gen_gpio_wq, &devdata->work, 0
+        + AUX_TIMEOUT		// постоянная смещения 1Гц: msecs_to_jiffies(1000)
+        + total_adj_j		// итоговая расчетная поправка: учитывает cadj + adj
+     );
+
+
+    //--------------------------------------------------------------------------------
+#if 0
+    test_sleep(devdata);
+#endif
+
+    {
+        /* информация по прыжку */
+        pr_info(DRV_LOG_PREFIX "jump specified: %luus (add %lu); resulting: %luus (add %lu); accure %+ldus; error=%+ld(%+ld)us",
+            specified_adj_us, devdata->adj_add,			// заданная величина прыжка (из нее add - часть запланированная для точной докрутки)
+            resulting_adj_us, dt_add_us,			// длина реально совершенного прыжка (из нее add - длительность точной докрутки)
+            devdata->accuracy_us,				// точность совершенного прыжка
+            devdata->error_us, devdata->error_us - error0_us	// ошибка относительно хода системных часов
+        );
+    }
+
+    if (devdata->cadj != devdata->cadj0)
+    {
+        devdata->cadj0 = devdata->cadj;
+        pr_info(DRV_LOG_PREFIX "cadj=%+ldus\n", devdata->cadj);
+    }
+
+
+    {
+        sleep(100);
+        pps_gen_stop_impulse(devdata);
+    }
+
+}
