+/**
+ * Получение адреса неэкспортируемой функции hrtimer_nanosleep()
+ */
+void init_hrtimer_nanosleep_ptr(void)
+{
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(5,7,7)
+    // only for kernel less then 5.7.7 (https://lore.kernel.org/lkml/20200221114404.14641-1-will@kernel.org/)
+    // otherwise use kprobe-method see (https://nskernel.gitbook.io/kernel-play-guide/accessing-the-non-exported-in-modules)
+    hrtimer_nanosleep_p = (void *)kallsyms_lookup_name("hrtimer_nanosleep");
+#else
+    hrtimer_nanosleep_p = resolve_symbol("hrtimer_nanosleep");
+#endif
+    pr_info(DRV_LOG_PREFIX "hrtimer_nanosleep address: %px\n", hrtimer_nanosleep_p);
+}
