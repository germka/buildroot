+/**
+ * own driver data structure
+ */
+struct pps_gen_gpio_devdata
+{
+    void *_nodata;
+    struct delayed_work work;				/* queue task */
+    struct gpio_desc *pps_gpio;				/* GPIO port descriptor */
+
+    struct timespec64 ts_at_start_measurement;		/* системное время в момент старта */
+    bool measurement_started;				/* флаг "измерение стартовало" */
+    long cadj;						/* постоянная поправка */
+    long cadj0;						/* для контроля изменения cadj */
+    long adj;						/* поправка расчетная (автоматически расчитываемая) */
+    unsigned long adj_add;				/* время прецезионной "доводки" в рамках N jiffie */
+    struct timespec64 ts_at_pps_front;			/* системное время в момент формирования фронта импульса */
+
+    unsigned long count;				/* (stat) Подсчет секунд отработанных сигналом PPS */
+    unsigned long restart;
+    long error_us;					/* значение ошибки относительно хода системных часов */
+    long accuracy_us;					/* точность выполнения прыжка */
+    unsigned long test_sleep_accuracy_max;
+};
