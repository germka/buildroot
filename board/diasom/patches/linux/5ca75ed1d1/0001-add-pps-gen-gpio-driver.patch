+
+/**
+ * Тестирование sleep()
+ */
+static void test_sleep(struct pps_gen_gpio_devdata* devdata)
+{
+    int delay[] = {1, 5, 10, 20, 50, 99, 100, 200, 999, 1000, 5000, 100, 100, 100, 100, 100, 100, 100};
+    int i;
+    for (i=0; i<sizeof(delay)/sizeof(int); i++)
+    {
+        struct timespec64 ts0, ts1;
+        ktime_get_real_ts64(&ts0);
+        sleep(delay[i]);
+        ktime_get_real_ts64(&ts1);
+        struct timespec64 dts = timespec64_sub(ts1, ts0);
+        unsigned long accuracy = dts.tv_nsec /1000 - delay[i];
+        if (devdata->test_sleep_accuracy_max < accuracy)
+            devdata->test_sleep_accuracy_max = accuracy;
+        pr_info(DRV_LOG_PREFIX "sleep %dus => %luus\n", delay[i], dts.tv_nsec /1000);
+    }
+    pr_info(DRV_LOG_PREFIX "accuracy_max=%luus\n", devdata->test_sleep_accuracy_max);
+}
+
+/**
+ * формирование начала импульса
+ *
+ * в случае если секундный тик на допустимом расстоянии 75ms,
+ * происходит ожидание
+ */
+static void pps_gen_make_impulse(struct pps_gen_gpio_devdata *devdata){
+	struct timespec64 tsi;
+	unsigned long j0;
+
+
+	gpiod_set_value(devdata->pps_gpio, PPS_GPIO_HIGH);
+#if 0
+	mod_timer(&devdata->timer_2, 0
+	    + jiffies
+	    + nsecs_to_jiffies(GPIO_PULSE_WIDTH_MIN_NS)
+	);
+#endif
+
+	ktime_get_real_ts64(&devdata->ts_at_pps_front);
+	devdata->count += 1;
+}
+
+/**
+ * формирование окончания импульса
+ *
+ * фиксированная длинна отмеряется относительно метки devdata->ts_at_pps_front
+*/
+static void pps_gen_stop_impulse(struct pps_gen_gpio_devdata *devdata){
+	unsigned long ja;
+	s64 si;
+	struct timespec64 tsi;
+	bool f_tick;
+	unsigned long j0;
+	struct timespec64 *ts0;
+
+#ifdef DEBUG
+	if (devdata->verbose > 10)
+		pr_info(DRV_LOG_PREFIX "%s %s[%d] stop %luimpulse", __BASE_FILE__, __func__, __LINE__, devdata->count);
+#endif
+
+#if 0
+	j0 = jiffies;
+	ts0 = &devdata->ts_at_pps_front;
+	do {
+		ktime_get_real_ts64(&tsi);
+		ja = 0;
+		if (tsi.tv_sec >= ts0->tv_sec)
+			ja += (tsi.tv_sec - ts0->tv_sec) * NSEC_PER_SEC;
+		else
+			break;
+		if (tsi.tv_nsec >= ts0->tv_nsec)
+			ja += tsi.tv_nsec - ts0->tv_nsec;
+		else if (ja > 0)
+			ja -= ts0->tv_nsec - tsi.tv_nsec;
+		else
+			break;
+		f_tick = si != tsi.tv_sec;
+		si = tsi.tv_sec;
+		// ----------
+
+
+
+	}while(true
+	    && ja > 0 && ja < NSEC_PER_JIFFIE * 2	// длина сигнала
+	    && jiffies < j0 + 2				// предохранительн
+	);
+#endif
+
+	gpiod_set_value(devdata->pps_gpio, PPS_GPIO_LOW);
+}
+
+
+/**
+ * Фиксация начала процесса измерения точности хода часов
+ */
+static void pps_gen_start_measurement(struct pps_gen_gpio_devdata *devdata, struct timespec64 *ts){
+    //ktime_get_real_ts64(&devdata->ts_at_start_measurement);
+    devdata->ts_at_start_measurement.tv_sec = ts->tv_sec;
+    devdata->ts_at_start_measurement.tv_nsec = ts->tv_nsec;
+    devdata->count = 0;		// pps count
+    devdata->restart += 1;	// количество перезапусков
+    devdata->adj = 0;
+    //devdata->сadj = devdata->сadj;	// постоянная поправки неизменна
+    devdata->cadj0 = 0;
+    devdata->measurement_started = true;
+
+    pr_info(DRV_LOG_PREFIX "start measurement %lu at %lld.%09ld\n", devdata->restart, (s64)devdata->ts_at_start_measurement.tv_sec, devdata->ts_at_start_measurement.tv_nsec);
+}
+
+/**
+ * поправку разбиваем на jiffie-часть и докручиваемую часть adj_add[us]
+ * 
+ * докручиваемая часть должна быть достаточной, чтобы нивелировать 
+ * запаздывание вызова в случае загрузки цпу и прочих возможных
+ * ситуаций
+ *
+ * http://gitlab.taipit.local/uspd/embedded/purple/-/issues/17#note_14545
+ *
+ */
+static signed long pps_gen_split_adj(struct pps_gen_gpio_devdata *devdata)
+{
+	long adj_j;	// value in jiffies
+	const int safety_period = 10;
+	long adj = devdata->cadj + devdata->adj;
+
+	if (devdata->adj > 0)
+	{
+		// devdata->cadj - value in us
+		//cadj_j = usecs_to_jiffies(devdata->cadj); cadj_j-=1;
+		    // unsigned long nsecs_to_jiffies(u64 n);
+		    // округляет в большую сторону
+		adj_j = adj / USEC_PER_JIFFIE;
+		devdata->adj_add = adj % USEC_PER_JIFFIE;
+	}
+	else
+	{
+		//cadj_j = usecs_to_jiffies(devdata->cadj * -1) * -1;
+		adj_j = adj / USEC_PER_JIFFIE - 1;
+		devdata->adj_add = USEC_PER_JIFFIE + adj % USEC_PER_JIFFIE;
+	}
+
+	{
+		adj_j -= safety_period;
+		devdata->adj_add += safety_period * USEC_PER_JIFFIE;
+	}
+
+	return adj_j;
+}
+
+
+/**
+ * Количество секундных тиков с начала измерения (расчитывается)
+ */
+static unsigned long get_seconds_since_measurement(struct pps_gen_gpio_devdata *devdata)
+{
+	struct timespec64 ts;
+	ktime_get_real_ts64(&ts);
+	if (ts.tv_sec < devdata->ts_at_start_measurement.tv_sec)
+	{
+		/* error: были переведены часы */
+		return 0;	// TODO:
+	}
+	return ts.tv_sec - devdata->ts_at_start_measurement.tv_sec;
+}
+
+/**
+ * Get cumulative error
+ *
+ * return long, ns - разница между ходом секунд и пульсовым генератором
+ */
+static long get_sectick_error(struct timespec64 *ts, struct pps_gen_gpio_devdata *devdata)
+{
+    long d1 = 0;
+    long d1_s, l1;
+
+    d1 = get_sectick_distance(ts);
+    d1_s = (devdata->count - get_seconds_since_measurement(devdata)) * NSEC_PER_SEC;
+    if (d1 < 0) l1 = 1; else l1 = 0;
+    d1_s += l1 * NSEC_PER_SEC;
+
+    return d1_s + d1;
+}
