# Systemd .timer file template for uspd2-slot-registrator
#
# Start timer:
#   systemctl start uspd2-slot-registrator-10min@slot1.timer
#
# Enable timer to start at boot:
#   systemctl enable uspd2-slot-registrator-10min@slot1.timer
#
# NOTE: %j and %J specifers supports since systemd version 239
#


[Unit]
Description=Run slot plc devices registration

[Timer]
Unit=uspd2-slot-registrator@%i.service
OnBootSec=3min
OnUnitActiveSec=40min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
