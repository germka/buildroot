[Unit]
Description=Database rotate caller
Requires=systemd-timesyncd.service time-sync-status.target
After=network.target time-sync.target onboot.service

[Service]
Type=oneshot
User=root
Group=root

ExecStart=bash -c 'START_DATE=7592(date +"%%FT%%T" -d "3 year ago"); echo "Removing data older than 7592{START_DATE}"; REQ=7592(echo "{\"filter\":{\"time\":\"7592{START_DATE}\"}}"); echo "7592{REQ}"; curl -v -X DELETE  -H "Content-Type: application/json" -d 7592{REQ} http://127.0.0.1:36090/api/v1/db/purge'

TimeoutStartSec=120
StandardOutput=syslog
StandardError=syslog
