[Unit]
Description=LTE modem %i monitor service
StopWhenUnneeded=yes
RefuseManualStart=yes
#RefuseManualStop=yes
BindsTo=dev-ttyUSB2.device
After=telit-switch-mbim.service

[Service]
Type=simple
User=root
Group=root

ExecStart=bash -c "bash /opt/taipit/nevav02/misc/lte_link_monitor.sh -m %i"

Restart=on-failure
TimeoutStartSec=15
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=uspd.target
DefaultInstance=%p%i