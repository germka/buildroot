[connection]
id=eth0-manual
uuid=dce47dc1-937e-360e-bcb2-a5745f1e170d
type=ethernet
interface-name=end0
permissions=
autoconnect-priority=0
autoconnect-retries=-1

[ethernet]
mac-address-blacklist=

[ipv4]
address1=192.168.1.2/24,192.168.1.2
dns=192.168.1.2
dns-search=
method=manual

[ipv6]
addr-gen-mode=eui64
dns-search=
method=ignore
