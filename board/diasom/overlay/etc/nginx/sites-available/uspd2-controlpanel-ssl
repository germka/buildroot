server {
  listen 443 ssl;
  server_name controlpanel-ssl;
  ssl_certificate /var/www/controlpanel/cert.pem;
  ssl_certificate_key /var/www/controlpanel/key.pem;

  location = /favicon.ico {
    access_log off;
    log_not_found off;
  }
  location /static {
    alias /var/www/controlpanel/static;
  }

  location / {
    include proxy_params;
    proxy_pass http://unix:/run/controlpanel.sock;
  }
}
