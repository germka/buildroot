config BR2_PACKAGE_PYTHON_VIRTUALENV
	bool "python-virtualenv"
	select BR2_PACKAGE_PYTHON_DISTLIB # runtime
	select BR2_PACKAGE_PYTHON_FILELOCK # runtime
	select BR2_PACKAGE_PYTHON_IMPORTLIB_METADATA # runtime
	select BR2_PACKAGE_PYTHON_PLATFORMDIRS # runtime
	select BR2_PACKAGE_PYTHON_TYPING_EXTENSIONS # runtime
	help
	  Virtual Python Environment builder.

	  https://github.com/pypa/virtualenv
